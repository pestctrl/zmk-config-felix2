#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define MOUSE   3
#define ADJUST  4

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "dvorak";

            // -----------------------------------------------------------------------------------------
            // |  GRV  |   1   |   2   |   3   |   4   |   5   |               |   6   |   7   |   8   |   9   |   0   |  DEL  |
            // |  TAB  |   Q   |   W   |   E   |   R   |   T   |               |   Y   |   U   |   I   |   O   |   P   |  BSPC |
            // | CTRL  |   A   |   S   |   D   |   F   |   G   |               |   H   |   J   |   K   |   L   |   ;   |   '   |
            // | SHIFT |   Z   |   X   |   C   |   V   |   B   |  [ {  | ] }   |   N   |   M   |   ,   |   .   |   /   |  RET  |
            // |  ADJ  |  ESC  |  ALT  |  GUI  |MOU/BSP| LOWER | SPACE | ENTER | RAISE |  BSPC | LEFT  | DOWN  |  UP   | RIGHT |

            bindings = <
&kp ESCAPE  &kp N1            &kp N2        &kp N3      &kp N4     &kp N5                     &kp N6     &kp N7     &kp N8  &kp N9  &kp N0  &kp BACKSPACE
&kp TAB     &kp SINGLE_QUOTE  &kp COMMA     &kp PERIOD  &kp P      &kp Y                      &kp F      &kp G      &kp C   &kp R   &kp L   &kp SLASH
&mo 1       &kp A             &kp O         &kp E       &kp U      &kp I                      &kp D      &kp H      &kp T   &kp N   &kp S   &kp ENTER
&kp LSHFT   &kp SEMICOLON     &kp Q         &kp J       &kp K      &kp X      &none    &none  &kp B      &kp M      &kp W   &kp V   &kp Z   &kp RIGHT_SHIFT
&kp LCTRL   &none             &kp LEFT_GUI  &kp LALT    &kp SPACE  &kp LSHFT  &none    &mo 3  &kp RSHFT  &kp SPACE  &mo 2   &mo 4   &none   &kp LCTRL
            >;
        };

        neo_layer_2 {
            display-name = "Neo Layer 2";

            // -----------------------------------------------------------------------------------------
            // |       |       |       |       |       |       |               |       |       |       |       |       |       |
            // |   ~   |   !   |   @   |   #   |   $   |   %   |               |   ^   |   &   |   *   |   (   |   )   |   |   |
            // |       |   `   |   -   |   =   |   [   |   ]   |               | LEFT  | DOWN  |  UP   | RIGHT |   \   |       |
            // |       |       |   _   |   +   |   {   |   }   |   (   |   )   | HOME  |  END  | PG_DN | PG_UP |       |       |
            // |       |       |       |       |       |       |       |       |       |       |       |       |       |       |

            bindings = <
&trans  &trans         &trans         &trans        &trans         &trans                           &trans         &trans         &trans        &trans     &trans         &trans
&trans  &trans         &kp LS(UNDER)  &kp LBKT      &kp RBKT       &kp LS(CARET)                    &kp LS(EXCL)   &kp LS(LT)     &kp LS(GT)    &kp EQUAL  &kp LS(AMPS)   &trans
&trans  &kp BSLH       &kp FSLH       &kp LS(LBRC)  &kp LS(RBRC)   &kp LS(STAR)                     &kp LS(QMARK)  &kp LS(LPAR)   &kp LS(RPAR)  &kp MINUS  &kp LS(COLON)  &kp LS(AT)
&trans  &kp LS(POUND)  &kp LS(DLLR)   &kp LS(PIPE)  &kp LS(TILDE)  &kp GRAVE      &trans    &trans  &kp LS(PLUS)   &kp LS(PRCNT)  &kp LS(DQT)   &kp SQT    &kp SEMI       &trans
&trans  &trans         &trans         &trans        &trans         &trans         &trans    &trans  &trans         &trans         &trans        &trans     &trans         &trans
            >;
        };

        neo_layer_3 {
            display-name = "Neo Layer 3";

            // -----------------------------------------------------------------------------------------
            // |       |       |       |       |       |       |               |       |       |       |       |       |       |
            // |       |   1   |   2   |   3   |   4   |   5   |               |   6   |   7   |   8   |   9   |   0   |  DEL  |
            // |       |  F1   |  F2   |  F3   |  F4   |  F5   |               |  F6   |   -   |   =   |   [   |   ]   |   \   |
            // |       |  F7   |  F8   |  F9   |  F10  |  F11  |  F12  |       |  F12  | PSCRN | PG_DN | PG_UP |       |       |
            // |       |       |       |       |       |       |       |       | NEXT  | VOL-  | VOL+  | PLAY  |       |       |

            bindings = <
&trans  &kp F1     &kp F2    &kp F3    &kp F4           &kp F5                       &kp F6  &kp F7           &kp F8           &kp F9           &kp F10             &trans
&trans  &kp PG_UP  &kp BSPC  &kp UP    &kp DEL          &kp PG_DN                    &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans              &kp F11
&trans  &kp HOME   &kp LEFT  &kp DOWN  &kp RIGHT        &kp END                      &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_NUMLOCK      &kp F12
&trans  &kp ESC    &kp TAB   &trans    &kp RET          &kp LC(Z)  &trans    &trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans              &trans
&trans  &trans     &trans    &trans    &kp KP_NUMBER_0  &trans     &trans    &trans  &trans  &kp KP_NUMBER_0  &trans           &trans           &kp LC(LA(DELETE))  &sys_reset
            >;
        };

        mouse_layer {
            display-name = "MOUSE";

            // Mouse movement on left ESDF cluster, scroll on W/R/A/G, clicks on thumbs and right JKL
            // -----------------------------------------------------------------------------------------
            // |       |       |       |       |       |       |               |       |       |       |       |       |       |
            // |       |       | SC_UP | MV_UP | SC_DN |       |               |       |       |       |       |       |       |
            // |       | SC_LT | MV_LT | MV_DN | MV_RT | SC_RT |               |       | LCLK  | RCLK  | MCLK  |       |       |
            // |       |       |       |       | LCLK  | RCLK  | MCLK  |       |       |       |       |       |       |       |
            // |       |       |       |       |       | LCLK  | MCLK  | RCLK  |       |       |       |       |       |       |

            bindings = <
&trans  &trans          &trans          &trans          &trans           &trans                                   &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans          &msc SCRL_UP    &mmv MOVE_UP    &msc SCRL_DOWN   &trans                                   &trans  &trans     &trans     &trans     &trans  &trans
&trans  &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT                          &trans  &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans  &trans
&trans  &trans          &trans          &trans          &mkp LCLK        &mkp RCLK        &mkp MCLK    &trans     &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans          &trans          &trans          &trans           &mkp LCLK        &mkp MCLK    &mkp RCLK  &trans  &trans     &trans     &trans     &trans  &trans
            >;
        };

        adjust_layer {
            display-name = "SYSTEM";

            // Bluetooth profile selection, output toggle, power
            // -----------------------------------------------------------------------------------------
            // |       |       |       |       |       |       |               |       |       |       |       |       |EP_TOG |
            // |BT_CALL|BT_SEL0|BT_SEL1|BT_SEL2|BT_SEL3|BT_SEL4|               |       |       |       |       |       |       |
            // |BT_NXT |OUT_TOG|OUT_USB|OUT_BLE|       |       |               |       |       |       |       |       |       |
            // |BT_PRV |       |       |       |       |       |       |       |       |       |       |       |       |       |
            // |       |       |       |       |       |       |       |       |       |       |       |       |       |       |

            bindings = <
&trans          &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &ext_power EP_TOG
&bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_NXT      &out OUT_TOG  &out OUT_USB  &out OUT_BLE  &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_PRV      &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
